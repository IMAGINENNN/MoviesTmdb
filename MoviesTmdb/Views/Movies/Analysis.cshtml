<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analysis - Movies TMDb</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
    <div class="container mx-auto p-6">
        <h2 class="text-3xl font-bold text-gray-800 mb-6">Analysis</h2>
        <div class="bg-white p-6 rounded-lg shadow-md mb-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Top Directors</h3>
            <ul class="list-disc pl-6">
                @foreach (var d in ViewBag.TopDirectors)
                {
                    <li class="text-gray-600">@d.Name</li>
                }
            </ul>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md mb-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Top Actors</h3>
            <ul class="list-disc pl-6">
                @foreach (var a in ViewBag.TopActors)
                {
                    <li class="text-gray-600">@a.Name</li>
                }
            </ul>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md mb-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Popular Genre by Decade</h3>
            <ul class="list-disc pl-6">
                @foreach (var item in ViewBag.GenreByDecade)
                {
                    <li class="text-gray-600">@item.Decade: @item.TopGenre</li>
                }
            </ul>
        </div>
        <a asp-action="Index" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 transition">Back to Movies</a>
    </div>
</body>
</html>